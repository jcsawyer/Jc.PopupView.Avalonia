<Project>

    <PropertyGroup Condition="'$(GeneratePackageOnBuild)' == 'true'">
        <RepositoryUrl>https://github.com/jcsawyer/Jc.PopupView.Avalonia</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup Condition="'$(GeneratePackageOnBuild)' == 'true'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    </ItemGroup>

</Project>
