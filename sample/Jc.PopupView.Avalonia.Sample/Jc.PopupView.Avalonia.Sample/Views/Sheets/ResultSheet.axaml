<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="260"
             x:Class="Jc.PopupView.Avalonia.Sample.Views.Sheets.ResultSheet">
    <StackPanel Spacing="12" Margin="16">
        <TextBlock Text="Move Message" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Choose where this message should go." Opacity="0.75" />

        <Button Content="Archive" Click="OnArchiveClick" />
        <Button Content="Important" Click="OnImportantClick" />
        <Button Content="Cancel" Click="OnCancelClick" />
    </StackPanel>
</UserControl>
