<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="240"
             x:Class="Jc.PopupView.Avalonia.Sample.Views.Popups.Popup1">
    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10">
        <TextBlock Classes="h2" Text="Quick tip" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Grid.Row="1" Classes="p" TextWrapping="Wrap" TextAlignment="Center"
                   Text="This centered popup scales in and out. You can dismiss it with this button or by tapping the backdrop." />
        <Button Grid.Row="2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#336B87"
                Foreground="#f5f5f5"
                FontWeight="SemiBold"
                Padding="12,10"
                Click="OnCloseClick">Close</Button>
    </Grid>
</UserControl>
