<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-ios</TargetFramework>
        <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
<!--        <RuntimeIdentifier>iossimulator-x64</RuntimeIdentifier>-->
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <CodesignKey>iPhone Developer</CodesignKey>
      <MlaunchAdditionalArgumentsProperty>--use-device-ctl=false --use-amdevice=true</MlaunchAdditionalArgumentsProperty>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" Version="12.1.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Jc.PopupView.Avalonia.Native.iOS\Jc.PopupView.Avalonia.Native.iOS.csproj" />
        <ProjectReference Include="..\Jc.PopupView.Avalonia.Sample\Jc.PopupView.Avalonia.Sample.csproj"/>
    </ItemGroup>
</Project>
